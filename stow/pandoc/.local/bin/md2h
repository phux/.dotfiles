#!/bin/bash
# Markdown -> PDF with a modern look: pandoc to HTML, then headless Chromium to PDF.
# Chromium is a snap and cannot read or write /tmp or hidden dirs, so work under $HOME.
set -euo pipefail

file_name="${1##*/}"
file="${file_name%.*}"
out="/tmp/${file}_$(date +"%Y-%m-%d").pdf"
pandoc_dir="$HOME/.local/share/pandoc"
work="$(mktemp -d -p "$HOME" md2h.XXXXXX)"
trap 'rm -rf "$work"' EXIT

pandoc "$1" \
  -f markdown -s --metadata pagetitle="$file" \
  --lua-filter="$pandoc_dir/luafilters/table-widths.lua" \
  -c "$pandoc_dir/themes/modern.css" --embed-resources \
  -o "$work/doc.html"
chromium --headless --disable-gpu --no-pdf-header-footer \
  --print-to-pdf="$work/doc.pdf" "file://$work/doc.html"
test -s "$work/doc.pdf"
mv "$work/doc.pdf" "$out"
echo "created pdf at ${out}"

xdg-open "${out}"
